rules_version = '2';

// ════════════════════════════════════════════════════════════════════
//  THE NEWTOWN CLASSES — Firestore Security Rules
// ════════════════════════════════════════════════════════════════════
//
//  HOW TO DEPLOY THESE RULES
//  ─────────────────────────
//  Option A (recommended — keeps these rules in version control):
//    1. Install the Firebase CLI:        npm install -g firebase-tools
//    2. From the project root, run:      firebase login
//    3. One-time init:                   firebase init firestore
//         (when prompted, use the EXISTING firestore.rules — don't overwrite)
//    4. Deploy:                          firebase deploy --only firestore:rules
//
//  Option B (no CLI):
//    1. Open Firebase Console → Firestore Database → Rules tab
//    2. Paste this entire file (everything below the comment block)
//    3. Click Publish
//
//  Default-deny: anything not explicitly matched below is denied.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isOwner == true;
    }
    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function isStaff() {
      return isAdmin() || isTeacher();
    }
    // True iff the incoming write only touches keys in `allowed`.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    // True iff the calling TEACHER may record attendance for `subject`. A
    // teacher's profile (teachers/{uid}) lists the subjects they teach in a
    // `subjects` array (e.g. ["Mathematics","Physics"]); older accounts may
    // only have a single `subject` string, which we still honour. "All
    // Subjects" in either field means any subject. Admins are intentionally
    // excluded: only teachers can mark attendance. The teacher portal and
    // admin panel use the same subject labels, so a direct match works.
    // Callers gate this with isTeacher(), so the teacher doc is guaranteed.
    function attnSubjectAllowed(subject) {
      let t = get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
      return t.get('subjects', []).hasAny([subject, 'All Subjects'])
          || t.get('subject', '') == subject
          || t.get('subject', '') == 'All Subjects';
    }
    // ─── students/{uid} ─────────────────────────────────────────────
    // Students can read their own profile.
    // Staff can read all students (needed for attendance, reports, results).
    // Only admin can create/delete students.
    // Students may update ONLY their own photoUrl (so the dashboard's photo
    // upload works); everything else (password, class, etc.) is admin-only.
    match /students/{uid} {
      allow get:    if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow list:   if isStaff();
      allow create, delete: if isAdmin() || isOwner();
      allow update: if isAdmin() || isOwner()
                    // Students may self-update only their photo and their
                    // one-time proctoring-consent timestamp (set before their
                    // first camera-monitored test). Nothing else.
                    || (request.auth.uid == uid && onlyChanges(['photoUrl','proctorConsentAt']));

      // ─── students/{uid}/offlineResults/{resultId} ─────────────────
      // Marks for offline (in-class) tests, uploaded from the teacher
      // portal (see saveOfflineMarks in teacher-dashboard.html, which
      // writes to students/{uid}/offlineResults/{baseId}).
      //
      // Rules do NOT cascade into subcollections, so this needs its own
      // match block — without it every write here hits the default-deny
      // and the teacher portal shows "Missing or insufficient permissions."
      //
      // The student can read their own offline results; staff (teachers
      // and admins) can read and write all of them.
      match /offlineResults/{resultId} {
        allow read:                   if isSignedIn() && (request.auth.uid == uid || isStaff());
        allow create, update, delete: if isStaff();
      }

      // ─── students/{uid}/attendance/{recordId} ─────────────────────
      // Attendance records. recordId is `${date}__${subjectKey}`.
      // READ: the student (their own) or any staff — admins view attendance
      // in the admin panel; teachers view it in the teacher portal.
      //
      // WRITE: teachers and admins. Rules enforced here, not just in UI:
      //  1. A teacher may only mark attendance for the subject they teach
      //     (attnSubjectAllowed). Admins may mark ANY subject.
      //  2. Once a record is 'present' it is FINAL for that day+subject —
      //     it cannot be overwritten or deleted from any client (teacher
      //     or admin alike).
      // ─── students/{uid}/answerSheetSubs/{subjectiveTestId} ────────
      // Tiny status marker (no marks) written by the check-answersheet
      // function via the service account, so the student dashboard can show
      // "awaiting teacher review" without exposing provisional AI marks. The
      // full grading lives in subjectiveResults and stays hidden until the
      // teacher releases it.
      match /answerSheetSubs/{tid} {
        allow read:  if isSignedIn() && (request.auth.uid == uid || isStaff());
        allow write: if false;
      }

      match /attendance/{recordId} {
        allow read:   if isSignedIn() && (request.auth.uid == uid || isStaff());
        allow create: if isAdmin()
                      || (isTeacher() && attnSubjectAllowed(request.resource.data.subject));
        allow update: if (isAdmin()
                          || (isTeacher() && attnSubjectAllowed(request.resource.data.subject)))
                      && resource.data.status != 'present';
        allow delete: if (isAdmin()
                          || (isTeacher() && attnSubjectAllowed(resource.data.subject)))
                      && resource.data.status != 'present';
      }
    }

    // ─── teachers/{uid} ─────────────────────────────────────────────
    // Teachers read their own profile; admin reads all.
    // Any signed-in user can list teachers — students need this to pick a
    // teacher in the "Ask a Doubt" chatbot. Sensitive write actions stay
    // admin-only. (The teacher document already only stores name/subject/
    // contact-style metadata, no passwords or private data.)
    // Only admin can create/update/delete teachers.
    match /teachers/{uid} {
      allow get:    if isSignedIn();
      allow list:   if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── admins/{uid} ───────────────────────────────────────────────
    // An admin can read their own admin doc to verify their role.
    // Nobody can write from the client — admins must be granted from
    // the Firebase Console, the Admin SDK, or the first-time bootstrap
    // script (which you should remove after running it once).
    match /admins/{uid} {
      allow get:    if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ─── chapters/{id}  (study material / PDFs) ─────────────────────
    // Any signed-in user can read; only staff can write.
    match /chapters/{id} {
      allow read:   if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── tests/{id} ─────────────────────────────────────────────────
    // Any signed-in user can read (students need to fetch a test to take it).
    // Only staff can create/modify tests.
    //
    // ⚠️ NOTE: Because the dashboard grades client-side, tests currently
    //   contain the correct-answer key in the document a student fetches.
    //   That's an app-design issue, not a rules issue — Firestore rules
    //   work at the document level, not the field level. Long-term, move
    //   grading to a Cloud Function so students never see the answer key.
    match /tests/{id} {
      allow read:   if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── testResults/{id} ───────────────────────────────────────────
    // Doc IDs are deterministic: `{testId}__{cycle}__{uid}` (see
    // student-dashboard.html). We require the doc ID to end with the
    // student's uid AND the `uid` field to match auth.uid, so a student
    // cannot fabricate a result for somebody else.
    //
    // Students can read ONLY their own result. Staff can read/list all.
    // Students can create their own once; updates are admin-only.
    // DELETE: admins always; a teacher may delete a result only for a test
    // THEY OWN (tests/{testId}.teacherUid == their uid) — this powers the
    // "↻ Re-allow retake" button in the teacher portal. Legacy tests that
    // predate the teacherUid field still need an admin.
    match /testResults/{id} {
      allow get:    if isSignedIn() && (
                       isStaff()
                       || (resource.data.uid == request.auth.uid)
                    );
      allow list:   if isStaff();
      allow create: if isSignedIn()
                    && id.matches('.*__' + request.auth.uid + '$')
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isTeacher()
                        && get(/databases/$(database)/documents/tests/$(resource.data.testId))
                             .data.get('teacherUid', '') == request.auth.uid);
    }

    // ─── attendance/{id} (legacy top-level collection) ──────────────
    // No longer written by any client — attendance now lives per-student
    // under students/{uid}/attendance and is teacher-only. Kept readable by
    // staff for any old records; nobody can write here from the client.
    match /attendance/{id} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ─── pushTokens/{token} ─────────────────────────────────────────
    // Web-push (FCM) device tokens. Doc ID is the token itself. Each doc:
    //   { token, uid, studentId, class, board, subjects[], updatedAt }
    // A signed-in user may register / refresh / remove a token only for
    // THEMSELVES (uid must match). Staff may read (for counts). The
    // send-push Netlify function reads + cleans up tokens via the service
    // account, which bypasses these rules.
    match /pushTokens/{token} {
      allow read:           if isStaff();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete:         if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── liveClasses/{id} ───────────────────────────────────────────
    // Any signed-in user can read the schedule.
    // Staff can create/update; only admin can delete.
    match /liveClasses/{id} {
      allow read:           if isSignedIn();
      allow create, update: if isStaff();
      allow delete:         if isAdmin();
    }

    // ─── questionImages/{id} ────────────────────────────────────────
    // Image references uploaded for test questions.
    // Any signed-in user can read; only staff can write.
    match /questionImages/{id} {
      allow read:                   if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── supportRequests/{id}  (Ask-a-Doubt chatbot) ───────────────
    // Created by a student when they click "Ask a Teacher" after the
    // chatbot couldn't fully answer their question. Each doc:
    //   { studentUid, studentId, studentName, teacherUid, subject,
    //     question, chatHistory, status: 'pending'|'resolved',
    //     createdAt, resolvedAt }
    //
    // - A student can create a request only with their own uid in
    //   `studentUid` and only with status = 'pending'.
    // - A student can read their own requests (to see status updates).
    // - The assigned teacher (or any admin) can read and update the
    //   request — typically to flip status to 'resolved'. Teachers
    //   cannot edit the original question/history.
    // - Only admin can delete.
    match /supportRequests/{id} {
      allow get:    if isSignedIn() && (
                       isAdmin()
                       || resource.data.studentUid == request.auth.uid
                       || resource.data.teacherUid == request.auth.uid
                    );
      allow list:   if isAdmin()
                    || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(
                         ['studentUid','studentId','studentName','teacherUid',
                          'subject','question','chatHistory','status','createdAt']);
      allow update: if (isAdmin()
                        || (isTeacher() && resource.data.teacherUid == request.auth.uid))
                    && onlyChanges(['status','resolvedAt','teacherNotes']);
      allow delete: if isAdmin();
    }

    // ─── enquiries/{id}  (website contact form) ────────────────────
    // Public website visitors may create one basic enquiry from the
    // contact form on the homepage. Reading/managing them is owner-only.
    match /enquiries/{id} {
      allow read, update, delete: if isOwner();
      allow create: if isOwner()
                    || (
                      request.resource.data.keys().hasOnly(
                        ['name','phone','email','course','currentClass',
                         'message','status','source','createdAt'])
                      && request.resource.data.keys().hasAll(
                        ['name','phone','course','status','source','createdAt'])
                      && request.resource.data.name is string
                      && request.resource.data.phone is string
                      && request.resource.data.course is string
                      && request.resource.data.status == 'New'
                      && request.resource.data.source == 'Website'
                    );
    }

    // ─── subjectiveTests/{id}  (AI answer-sheet checker — questions) ─
    // Student-visible part of a subjective assignment: question text + max
    // marks + topic only. The marking key (model answers, marking points)
    // lives in subjectiveTestKeys and is staff-only, so students never see it.
    match /subjectiveTests/{id} {
      allow read:                   if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── subjectiveTestKeys/{id}  (marking scheme — staff only) ─────
    // Model answers + marking points. Read/written only by staff; the
    // check-answersheet function reads it via the service account (which
    // bypasses these rules) to grade. Students can NEVER read this.
    match /subjectiveTestKeys/{id} {
      allow read, write: if isStaff();
    }

    // ─── subjectiveResults/{id}  (AI grading of an answer sheet) ─────
    // Doc id: {subjectiveTestId}__{cycle}__{uid}. Written ONLY by the
    // check-answersheet function via the service account, so a student can't
    // fabricate marks. The student may read their OWN result only once the
    // teacher has released it (status == 'released'). Staff read all and may
    // adjust marks/notes + flip status to 'released' (the review gate).
    match /subjectiveResults/{id} {
      allow get:    if isSignedIn() && (
                       isStaff()
                       || (resource.data.uid == request.auth.uid && resource.data.status == 'released')
                    );
      allow list:   if isStaff();
      allow create, delete: if false;
      allow update: if isStaff()
                    && onlyChanges(['finalGrading','teacherNotes','status','releasedAt']);
    }

    // ─── ncertIndex/{class}_{subject}  (published-chapter index) ────
    // Tiny doc per class+subject: { published: [1,3,5], updatedAt }.
    // The public /ncert/ chapter-list page reads exactly ONE of these to
    // decide which chapters show "Available" vs "Coming soon" — that's why
    // it needs no composite index and no query. PUBLIC (unauthenticated)
    // read by design: NCERT solutions are a free, SEO-facing resource.
    //
    // WRITE IS ADMIN-ONLY. NCERT material is uploaded from the admin panel;
    // teachers deliberately have no access to it.
    match /ncertIndex/{id} {
      allow get:   if true;
      allow list:  if isStaff();
      allow write: if isAdmin();
    }

    // ─── ncertSolutions/{class}_{subject}_{NN}  (chapter PDFs) ───────
    // Doc id e.g. "10_science_09". Each doc:
    //   { class, subject, subjectLabel, chapterNumber, chapterTitle,
    //     intro, pdfUrl, pdfName, pdfSize, isPublished,
    //     uploadedBy, updatedAt }
    //
    // PUBLIC read, but ONLY once an admin has flipped isPublished — an
    // unpublished draft stays invisible to the world. Staff can always read
    // (so the admin panel can load drafts back into the form).
    //
    // The public page only ever does a `get` on a known doc id, never a
    // query, so this rule is evaluated per-document and needs no
    // query-constraint gymnastics.
    //
    // WRITE IS ADMIN-ONLY — isStaff() would include teachers, which is
    // exactly what we do not want here.
    match /ncertSolutions/{id} {
      allow get:    if resource.data.isPublished == true || isStaff();
      allow list:   if isStaff();
      allow create, update: if isAdmin()
                    && request.resource.data.isPublished is bool
                    && request.resource.data.pdfUrl is string;
      allow delete: if isAdmin();
    }

    // ─── DEFAULT DENY ───────────────────────────────────────────────
    // Anything not matched above is denied. (No catch-all match block.)
  }
}
